#!/usr/bin/env bash
# tmux-theme-preview — try colour themes on the running tmux, live.
#
#   tmux-theme-preview              list the themes, marking the one shown
#   tmux-theme-preview pick        open a popup with live previews
#   tmux-theme-preview NAME         show NAME
#   tmux-theme-preview next|prev    show the next or previous one in the list
#   tmux-theme-preview reset        back to what .tmux.conf sets (Woodland Dusk)
#
# A theme is one of the palettes in tmux/.config/tmux/themes/ (Gruvbox,
# Catppuccin, Rosé Pine, ...) or one of tmux-oasis's own flavors.  Either
# way tmux-oasis draws it, so the layout is the one you have and only the
# colours change.  Pane backgrounds are painted in the theme's mantle, the
# colour scripts/oasis-theme gives Ghostty, so the preview shows the theme
# whole without touching Ghostty.
#
# Nothing is written.  A preview lasts until `reset', or until tmux reloads
# .tmux.conf or restarts.  To keep an oasis flavor, see scripts/oasis-theme.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
THEMES="$REPO/tmux/.config/tmux/themes"
OASIS="$REPO/tmux/.tmux/plugins/tmux-oasis"
ROLES=(strong_primary primary light_primary secondary prefix fg
       core mantle surface visual red orange yellow green teal blue indigo)

tmux info &>/dev/null || { echo "tmux is not running" >&2; exit 1; }

themes() {
  for f in "$THEMES"/*.conf; do basename "$f" .conf; done
  for f in "$OASIS"/themes/dark/oasis_*.conf; do
    f=$(basename "$f" .conf); echo "${f#oasis_}"
  done
}

current() { tmux show -gqv @theme_preview; }

# oasis sets its palette with `set -o', which leaves a value already set
# alone, so the last theme's colours go first.
clear_palette() {
  for role in "${ROLES[@]}"; do tmux set -gu "@thm_$role"; done
}

# Show theme $1; $2, if given, says where it is in the list.
show() {
  local name=$1 where=${2:-} flavor border_status border_format
  border_status=$(tmux show -gwv pane-border-status)
  border_format=$(tmux show -gwv pane-border-format)
  if [[ -f "$THEMES/$name.conf" ]]; then
    flavor=dune_dark  # any: the palette is set first, so its colours win
  elif [[ -f "$OASIS/themes/dark/oasis_$name.conf" ]]; then
    flavor=$name
  else
    echo "No such theme: $name; run with no arguments for the list" >&2
    exit 1
  fi
  clear_palette
  [[ "$flavor" == "$name" ]] || tmux source-file "$THEMES/$name.conf"
  tmux set -g @oasis_flavor "$flavor"
  tmux source-file "$OASIS/oasis_tmux.conf"
  tmux set -gw pane-border-status "$border_status"
  tmux set -gw pane-border-format "$border_format"
  # As .tmux.conf does after oasis: the legacy status colours follow it.
  tmux set -Fg status-bg '#{@thm_mantle}'
  tmux set -Fg status-fg '#{@thm_secondary}'
  tmux set -Fg window-style 'bg=#{@thm_mantle}'
  tmux set -Fg window-active-style 'bg=#{@thm_mantle}'
  # Keep local/SSH cues when previewing a different shared palette.
  tmux source-file "$REPO/tmux/.config/tmux/connection-theme.conf"
  tmux set -g @theme_preview "$name"
  if [[ ${PICKING:-0} != 1 ]]; then
    tmux display-message "theme: $name  (tmux-theme-preview next | prev | reset)"
  fi
  echo "theme: $name${where:+  ($where)}"
}

step() {
  local list here i
  list=($(themes))  # names have no spaces; macOS's bash 3.2 has no mapfile
  here=$(current)
  i=-1
  for j in "${!list[@]}"; do [[ "${list[$j]}" == "$here" ]] && i=$j; done
  if (( i < 0 )); then
    (( $1 > 0 )) && i=0 || i=$(( ${#list[@]} - 1 ))
  else
    i=$(( (i + $1 + ${#list[@]}) % ${#list[@]} ))
  fi
  show "${list[$i]}" "$(( i + 1 )) of ${#list[@]}"
}

# Limit rollback to appearance options; do not overwrite unrelated live changes.
appearance() {
  tmux show "$1" | awk '
    $1 ~ /^(@thm_|@oasis_|@connection_|@theme_preview$|status-|message-|mode-style$|clock-mode-colour$|menu-selected-style$|popup-|pane-border-|pane-active-border-style$|window-style$|window-active-style$|window-status-)/'
}

picker_cleanup() {
  local scope line option
  trap - EXIT HUP INT TERM RETURN
  if [[ $accepted != 1 ]]; then
    for scope in -g -gw; do
      # Remove options introduced by a preview, then restore the saved values.
      while IFS= read -r line; do
        option=${line%% *}
        tmux set "$scope" -u "$option"
      done < <(appearance "$scope")
    done
    tmux source-file "$snapshot"
  fi
  rm -f "$snapshot"
  printf '\033[0m\033[?25h'
}

picker() {
  local list here selected=0 top=0 rows height width key tail i scope
  local snapshot accepted=0 PICKING=1
  [[ -t 0 && -t 1 ]] || { echo "The picker needs a terminal" >&2; return 1; }
  list=($(themes))
  here=$(current)
  for i in "${!list[@]}"; do
    [[ ${list[$i]} != "$here" ]] || selected=$i
  done
  snapshot=$(mktemp "${TMPDIR:-/tmp}/tmux-theme.XXXXXXXX")
  for scope in -g -gw; do
    # show-options leaves bare hex colors unquoted; quote them so tmux
    # does not parse the value as a comment when restoring the file.
    appearance "$scope" | sed -E 's/^([^ ]+) (#.*)$/\1 "\2"/' |
      sed "s/^/set-option $scope /" >> "$snapshot"
  done
  trap picker_cleanup EXIT
  trap 'picker_cleanup; trap - RETURN' RETURN
  trap 'exit 130' INT
  trap 'exit 143' HUP TERM
  printf '\033[?25l'
  show "${list[$selected]}" >/dev/null
  while :; do
    read -r height width < <(stty size)
    rows=$((height - 5))
    ((rows > 0)) || rows=1
    ((selected >= top)) || top=$selected
    ((selected < top + rows)) || top=$((selected - rows + 1))
    printf '\033[H\033[2JThemes — live preview\r\n↑/↓ or j/k · Enter keep · Esc cancel\r\n\r\n'
    for ((i=top; i<${#list[@]} && i<top+rows; i++)); do
      if ((i == selected)); then
        printf '\033[7m> %-*.*s\033[0m\r\n' "$((width - 3))" "$((width - 3))" "${list[$i]}"
      else
        printf '  %.*s\r\n' "$((width - 3))" "${list[$i]}"
      fi
    done
    printf '\r\n%d / %d' "$((selected + 1))" "${#list[@]}"
    IFS= read -rsn1 key || return 1
    if [[ $key == $'\e' ]]; then
      tail=
      if IFS= read -rsn1 -t 0.1 tail && [[ $tail == '[' || $tail == O ]]; then
        IFS= read -rsn1 -t 0.1 key || return 0
        case "$key" in A) key=k ;; B) key=j ;; *) continue ;; esac
      else
        return 0
      fi
    fi
    case "$key" in
      k) selected=$(((selected + ${#list[@]} - 1) % ${#list[@]})) ;;
      j) selected=$(((selected + 1) % ${#list[@]})) ;;
      '') accepted=1; return 0 ;;
      q|$'\003') return 0 ;;
      *) continue ;;
    esac
    show "${list[$selected]}" >/dev/null
  done
}

case "${1:-}" in
  "")
    here=$(current)
    while read -r name; do
      if [[ "$name" == "$here" ]]; then echo "* $name"; else echo "  $name"; fi
    done < <(themes)
    [[ -n "$here" ]] || echo "(showing .tmux.conf's own theme)"
    ;;
  pick)
    printf -v picker_command '%q --picker' "$REPO/scripts/tmux-theme-preview"
    tmux display-popup -E -w 52 -h 22 -T 'Theme preview' "$picker_command"
    ;;
  --picker) picker ;;
  next) step 1 ;;
  prev) step -1 ;;
  reset)
    clear_palette
    tmux set -gu window-style
    tmux set -gu window-active-style
    tmux set -gu @theme_preview
    tmux source-file ~/.tmux.conf
    tmux display-message "theme: back to .tmux.conf's"
    echo "theme: back to .tmux.conf's"
    ;;
  *) show "$1" ;;
esac
