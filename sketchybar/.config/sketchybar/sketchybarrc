#!/usr/bin/env bash

# Gruvbox SketchyBar config — matched to waybar layout
# Left:   workspaces, front_app, clock
# Center: emtpy (under camera)
# Right:  tokens, calendar, cpu, memory, disk, volume, network, vpn, battery

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
# Position top, height ~31 to match waybar.
# Window layering avoids reserving a second row for the native menu bar,
# while keeping its revealed menus above SketchyBar.
sketchybar --bar \
  position=top \
  height=31 \
  color=$BG \
  border_width=0 \
  shadow=off \
  topmost=window \
  y_offset=0 \
  margin=0 \
  corner_radius=0 \
  blur_radius=0 \
  notch_width=0

##### Defaults #####
# Font: JetBrainsMono Nerd Font — matches waybar CSS
default=(
  padding_left=6
  padding_right=6
  icon.font="JetBrainsMono Nerd Font:Bold:14.0"
  label.font="JetBrainsMono Nerd Font:Regular:13.0"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### AeroSpace Workspace Indicators (left) #####
# Register custom event from AeroSpace
sketchybar --add event aerospace_workspace_change

for sid in $(seq 1 10); do
  sketchybar --add item space.$sid left \
    --set space.$sid \
      icon="$sid" \
      icon.padding_left=8 \
      icon.padding_right=8 \
      label.drawing=off \
      icon.color=$BG2 \
      drawing=off \
      background.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

# Subscribe all space items to the workspace change event
for sid in $(seq 1 10); do
  sketchybar --subscribe space.$sid aerospace_workspace_change
done

# Trigger initial workspace visibility update
FOCUSED=$(aerospace list-workspaces --focused 2>/dev/null)
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$FOCUSED"

##### Separator + Front App (left) #####
sketchybar --add item separator left \
  --set separator \
    icon="│" \
    icon.color=$BG2 \
    label.drawing=off \
    icon.padding_left=4 \
    icon.padding_right=4

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.color=$FG2 \
    label.font="JetBrainsMono Nerd Font:Regular:13.0" \
    label.max_chars=50 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Clock (center) #####
# Format: "Mon, 23 Mar 2026    14:30" (icon between date and time)
# Click the clock for a month calendar and athan for today's prayer times,
# as in Waybar; plugins/popup.py fills both in. Clicking away closes them.
# The calendar's month arrows sit either side of its title.
popup_style=(
  popup.align=left
  popup.background.color=$BG1
  popup.background.corner_radius=6
  popup.background.border_width=1
  popup.background.border_color=$BG2
)

sketchybar --add item clock left \
  --set clock \
    icon.drawing=off \
    label.color=$BR_YELLOW \
    update_freq=10 \
    "${popup_style[@]}" \
    click_script="$PLUGIN_DIR/popup.py calendar toggle" \
    script="$PLUGIN_DIR/clock.sh" \
  --subscribe clock mouse.exited.global

# Athan — next prayer time (matches waybar custom/adhan)
sketchybar --add item athan left \
  --set athan \
    icon="☾" \
    icon.color=$BR_PURPLE \
    label.color=$BR_PURPLE \
    update_freq=60 \
    "${popup_style[@]}" \
    click_script="$PLUGIN_DIR/popup.py prayers toggle" \
    script="$PLUGIN_DIR/athan.sh" \
  --subscribe athan mouse.exited.global

# Now Playing: what macOS is playing, from any app -- Podcasts, Music,
# Safari, spotify_player -- with its title and elapsed/duration, hidden when
# nothing is. Click for the whole title and the controls. A watcher started
# by plugins/nowplaying.py runs `media-control stream` and triggers
# nowplaying_update on every change, so nothing polls.
sketchybar --add event nowplaying_update \
  --add item nowplaying left \
  --set nowplaying \
    icon.color=$BR_GREEN \
    label.color=$BR_GREEN \
    drawing=off \
    update_freq=30 \
    "${popup_style[@]}" \
    click_script="$PLUGIN_DIR/nowplaying.py toggle" \
    script="$PLUGIN_DIR/nowplaying.py update" \
  --subscribe nowplaying nowplaying_update system_woke mouse.exited.global

##### Right side items (added right-to-left) #####

# Battery — br_green (matches waybar)
sketchybar --add item battery right \
  --set battery \
    icon.color=$BR_GREEN \
    label.color=$BR_GREEN \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# VPN — br_green when connected, br_red when disconnected
sketchybar --add item vpn right \
  --set vpn \
    update_freq=120 \
    script="$PLUGIN_DIR/vpn.sh"

# Network — br_aqua (matches waybar)
sketchybar --add item network right \
  --set network \
    update_freq=10 \
    script="$PLUGIN_DIR/network.sh" \
  --subscribe network wifi_change

# Volume — br_orange (matches waybar pulseaudio)
sketchybar --add item volume right \
  --set volume \
    icon.color=$BR_ORANGE \
    label.color=$BR_ORANGE \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

# Disk — br_aqua (matches waybar)
sketchybar --add item disk right \
  --set disk \
    icon="󰋊 " \
    icon.color=$BR_AQUA \
    label.color=$BR_AQUA \
    update_freq=120 \
    script="$PLUGIN_DIR/disk.sh"

# Memory — br_blue (matches waybar)
sketchybar --add item memory right \
  --set memory \
    icon="󰍛 " \
    icon.color=$BR_BLUE \
    label.color=$BR_BLUE \
    update_freq=30 \
    script="$PLUGIN_DIR/memory.sh"

# CPU — br_green (matches waybar)
sketchybar --add item cpu right \
  --set cpu \
    icon=" " \
    icon.color=$BR_GREEN \
    label.color=$BR_GREEN \
    update_freq=30 \
    script="$PLUGIN_DIR/cpu.sh"

# Calendar — current/next event (Eames-style); click for the rest of today.
# Needs helpers/calendar.app built and approved (see helpers/build.sh).
# Label length is capped in plugins/calendar.sh to keep it clear of the notch.
sketchybar --add item calendar right \
  --set calendar \
    icon=" " \
    drawing=off \
    update_freq=30 \
    popup.align=right \
    popup.background.color=$BG1 \
    popup.background.corner_radius=6 \
    popup.background.border_width=1 \
    popup.background.border_color=$BG2 \
    click_script="sketchybar --set calendar popup.drawing=toggle" \
    script="$PLUGIN_DIR/calendar.sh" \
  --subscribe calendar system_woke mouse.exited.global

# Tokens — Apple Claude Code's spend meter, as Claude Code's status line shows
# it: today's spend and the share of the budget, going from green to red as it
# runs down.  Drawn only while a Claude Code session is running (its proxy is
# alive and answering) and hidden otherwise.  Click for tokens, calls, the rate
# limit, the reset time and the costliest model.  plugins/tokens.py asks the
# proxy on loopback; nothing is written to ~/.claude.
sketchybar --add item tokens right \
  --set tokens \
    drawing=off \
    update_freq=20 \
    popup.align=right \
    popup.background.color=$BG1 \
    popup.background.corner_radius=6 \
    popup.background.border_width=1 \
    popup.background.border_color=$BG2 \
    click_script="$PLUGIN_DIR/tokens.py toggle" \
    script="$PLUGIN_DIR/tokens.py update" \
  --subscribe tokens system_woke mouse.exited.global

##### Force initial update #####
sketchybar --update
