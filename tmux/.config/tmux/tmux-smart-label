#!/usr/bin/env bash

set -euo pipefail

mode="${1:-pane}"
pane_path="${2:-}"
pane_command="${3:-}"
pane_label_override="${4:-}"

# The Meta workstation puts a telemetry wrapper in /usr/local/bin/git.  This
# helper is UI plumbing, so use the real Git binary and avoid launching the
# telemetry logger whenever a label is refreshed.  Keep an override for hosts
# where Git lives elsewhere.
if [ -n "${TMUX_SMART_LABEL_GIT:-}" ]; then
  git_bin="$TMUX_SMART_LABEL_GIT"
elif [ -x /usr/bin/git ]; then
  git_bin=/usr/bin/git
else
  git_bin="$(command -v git 2>/dev/null || true)"
fi

tmux_bin="${TMUX_SMART_LABEL_TMUX:-tmux}"
tmux_args=()
if [ -n "${TMUX:-}" ]; then
  tmux_args=(-S "${TMUX%%,*}")
fi

tmux_call() {
  "$tmux_bin" "${tmux_args[@]}" "$@"
}

trim() {
  local value="${1:-}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

slash_count() {
  local value="${1:-}"
  local slashes="${value//[^\/]/}"
  printf '%s' "${#slashes}"
}

expand_path() {
  local value="${1:-}"
  case "$value" in
    \~)
      printf '%s' "$HOME"
      ;;
    \~/*)
      printf '%s/%s' "$HOME" "${value:2}"
      ;;
    *)
      printf '%s' "$value"
      ;;
  esac
}

shell_command() {
  case "${1:-}" in
    sh|bash|zsh|fish)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

path_like_title() {
  case "${1:-}" in
    /|/*|\~|\~/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

git_label() {
  local label_mode="$1"
  local path="$2"
  local repo_root repo_name rel slash_count tail parent prev

  if [ -z "$git_bin" ]; then
    return 1
  fi

  repo_root="$("$git_bin" -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$repo_root" ]; then
    return 1
  fi

  repo_name="${repo_root##*/}"
  rel="$("$git_bin" -C "$path" rev-parse --show-prefix 2>/dev/null || true)"
  rel="${rel%/}"

  if [ -z "$rel" ]; then
    printf '%s' "$repo_name"
    return 0
  fi

  slash_count="$(slash_count "$rel")"
  if [ "$label_mode" = "window" ]; then
    if [ "$slash_count" -eq 0 ]; then
      printf '%s/%s' "$repo_name" "$rel"
    else
      printf '%s/.../%s' "$repo_name" "${rel##*/}"
    fi
    return 0
  fi

  if [ "$slash_count" -le 1 ]; then
    printf '%s/%s' "$repo_name" "$rel"
    return 0
  fi

  tail="${rel##*/}"
  parent="${rel%/*}"
  prev="${parent##*/}"
  printf '%s/.../%s/%s' "$repo_name" "$prev" "$tail"
}

home_label() {
  local label_mode="$1"
  local path="$2"
  local rel slash_count tail parent prev

  if [ "$path" = "$HOME" ]; then
    printf '~'
    return 0
  fi

  case "$path" in
    "$HOME"/*)
      rel="${path#$HOME/}"
      ;;
    *)
      return 1
      ;;
  esac

  slash_count="$(slash_count "$rel")"
  if [ "$label_mode" = "window" ]; then
    if [ "$slash_count" -le 1 ]; then
      printf '~/%s' "$rel"
    else
      tail="${rel##*/}"
      parent="${rel%/*}"
      printf '~/%s/%s' "${parent##*/}" "$tail"
    fi
    return 0
  fi

  if [ "$slash_count" -le 1 ]; then
    printf '~/%s' "$rel"
    return 0
  fi

  tail="${rel##*/}"
  parent="${rel%/*}"
  prev="${parent##*/}"
  printf '~/.../%s/%s' "$prev" "$tail"
}

absolute_label() {
  local label_mode="$1"
  local path="${2%/}"
  local rel slash_count tail parent prev

  if [ -z "$path" ]; then
    printf '/'
    return 0
  fi

  rel="${path#/}"
  slash_count="$(slash_count "$rel")"
  if [ "$label_mode" = "window" ]; then
    if [ "$slash_count" -le 1 ]; then
      printf '/%s' "$rel"
    else
      tail="${rel##*/}"
      parent="${rel%/*}"
      printf '%s/%s' "${parent##*/}" "$tail"
    fi
    return 0
  fi

  if [ "$slash_count" -le 1 ]; then
    printf '/%s' "$rel"
    return 0
  fi

  tail="${rel##*/}"
  parent="${rel%/*}"
  prev="${parent##*/}"
  printf '.../%s/%s' "$prev" "$tail"
}

path_label() {
  local label_mode="$1"
  local raw_path="${2:-}"
  local path

  path="$(expand_path "$raw_path")"
  if [ -z "$path" ]; then
    printf '%s' "${pane_command:-shell}"
    return 0
  fi

  git_label "$label_mode" "$path" && return 0
  home_label "$label_mode" "$path" && return 0
  absolute_label "$label_mode" "$path"
}

pane_label() {
  local title

  title="$(trim "$pane_label_override")"
  if [ -n "$title" ]; then
    if path_like_title "$title"; then
      path_label pane "$title"
      return 0
    fi

    if [ "$title" != "$pane_command" ]; then
      printf '%s' "$title"
      return 0
    fi
  fi

  if shell_command "$pane_command"; then
    path_label pane "$pane_path"
    return 0
  fi

  printf '%s' "${pane_command:-$pane_path}"
}

refresh_pane() {
  local target="${1:-${TMUX_PANE:-}}"
  local command_override="${2:-}"
  local pane_active computed_pane_label computed_window_label

  if [ -z "$target" ]; then
    return 0
  fi

  pane_path="$(tmux_call display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || true)"
  pane_command="$(tmux_call display-message -p -t "$target" '#{pane_current_command}' 2>/dev/null || true)"
  pane_active="$(tmux_call display-message -p -t "$target" '#{pane_active}' 2>/dev/null || true)"
  pane_label_override="$(tmux_call show-options -pqv -t "$target" @smart_label 2>/dev/null || true)"

  if [ -n "$command_override" ]; then
    pane_command="${command_override##*/}"
  fi

  computed_pane_label="$(pane_label)"
  computed_window_label="$(path_label window "$pane_path")"

  tmux_call set-option -pq -t "$target" @smart_pane_label "$computed_pane_label"
  tmux_call set-option -pq -t "$target" @smart_window_label "$computed_window_label"

  # A window's label follows its active pane, matching tmux automatic-rename.
  if [ "$pane_active" = 1 ]; then
    tmux_call rename-window -t "$target" "$computed_window_label"
  fi
}

refresh_all() {
  local target

  while IFS= read -r target; do
    refresh_pane "$target"
  done < <(tmux_call list-panes -a -F '#{pane_id}')
}

case "$mode" in
  window)
    path_label window "$pane_path"
    ;;
  pane)
    pane_label
    ;;
  refresh)
    refresh_pane "${2:-}" "${3:-}"
    ;;
  refresh-all)
    refresh_all
    ;;
  *)
    printf '%s' "$pane_label_override"
    ;;
esac
