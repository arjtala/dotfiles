{
    "layer": "top",
    "position": "bottom",
    "height": 31,
    "modules-left": [
        "sway/workspaces",
        "sway/window",
        "clock",
        "custom/adhan",
        "custom/nowplaying"
    ],
    "modules-center": [],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "custom/nvidia",
        "pulseaudio",
        "network",
        "bluetooth",
        "backlight",
        "custom/vpn",
        "battery",
        "tray"
    ],
    "sway/window": {
        "format": "{app_id}",
        "max-length": 20,
        "tooltip": false,
        "rewrite": {
            "com.mitchellh.ghostty": "Ghostty",
            "org.mozilla.firefox": "Firefox",
            "firefox": "Firefox",
            "org.gnome.Nautilus": "Files"
        }
    },
    "clock": {
        "format": "{:%a, %d %b %Y     %H:%M}",
        "timezone": "America/Los_Angeles",
        "on-click": "python3 $HOME/.config/waybar/scripts/popup.py calendar",
        "tooltip": false,
        "tooltip-format": " <tt><span size='11pt'>{calendar}</span></tt> ",
        "calendar": {
            "mode": "month",
            "week-pos": "right",
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ebdbb2'><b>{}</b></span>",
                "days": "<span color='#83a598'>{}</span>",
                "weeks": "<span color='#d3869b'><b>W{}</b></span>",
                "weekdays": "<span color='#fabd2f'><b>{}</b></span>",
                "today": "<span color='#fb4934'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "tray": {
        "icon-size": 15
    },
    "sway/workspaces": {
        "format": "{name}",
        "tooltip": false,
        "all-outputs": true
    },
    "cpu": {
        "interval": 3,
        "format": "  {usage:2}%",
        "max-length": 10,
        "tooltip": false,
        "warning": 70,
        "critical": 85,
        "on-click": "ghostty -e htop"
    },
    "memory": {
        "interval": 3,
        "format": "󰍛  {percentage:2}%",
        "max-length": 10,
        "tooltip": false,
        "warning": 70,
        "critical": 85,
        "on-click": "ghostty -e htop"
    },
    "disk": {
        "interval": 120,
        "tooltip": false,
        "format": "󰋊  {free}"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "on-click": "blueman-manager"
    },
    "custom/nvidia": {
        "format": "󰏔  {}",
        "interval": 60,
        "exec": "$HOME/.config/waybar/scripts/system-nvidia-smi.sh",
        "tooltip": false
    },
    "custom/adhan": {
        "format": "☾ {}",
        "interval": 60,
        "tooltip": false,
        "exec": "zsh -lc athan",
        "on-click": "python3 $HOME/.config/waybar/scripts/popup.py prayers",
        "icon-size": 10,
        "spacing": 10
    },
    "battery": {
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 12
        },
        "format": "{icon}  ",
        "format-charging": " {capacity}%  ",
        "format-plugged": "  {capacity}%  ",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-alt": "{icon} {capacity}% ({time})  "
    },
    "network": {
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-icons": {
            "wifi": [
                ""
            ],
            "ethernet": [
                "󰈀"
            ],
            "disconnected": [
                ""
            ]
        },
        "on-right-click": "nm-connection-editor",
        "tooltip-format": "{icon} {essid} [{ipaddr}] 𝌩 {signalStrength}% <span color='#b8bb26'>  {bandwidthUpBits}</span> <span color='#fb4934'>  {bandwidthDownBits}</span> <span color='#d3869b'>󰹹 {bandwidthTotalBits}</span>"
    },
    "custom/vpn": {
        "format": "{}",
        "interval": 15,
        "return-type": "json",
        "exec": "python3 $HOME/.config/waybar/scripts/vpn.py",
        "tooltip": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "{icon} {volume}% {format_source}",
        "format-bluetooth-muted": " {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "  {volume}%",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "device": "acpi_video0",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃠"
        ],
        "tooltip": false,
        "scroll-step": 5,
        "min-brightness": 5
    },
    "custom/nowplaying": {
        "format": "{}",
        "return-type": "json",
        "exec": "python3 $HOME/.config/waybar/scripts/nowplaying.py",
        "restart-interval": 3,
        "exec-on-event": false,
        "tooltip": false,
        "on-click": "python3 $HOME/.config/waybar/scripts/popup.py nowplaying"
    }
}
